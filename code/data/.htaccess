# ==========================================================================
# data/ 目录 · 只允许 PHP 读写，任何人都不能通过网址下载
# 这里放的是 trips.json（全部旅行数据）与限流、缓存的临时文件。
# ==========================================================================

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
